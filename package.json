{
  "name": "4sib-discord-bot",
  "version": "1.0.0",
  "description": "Bot Discord pour le serveur 4SIB",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "deploy": "node deploy-commands.js",
    "test": "node --test tests/*.test.js",
    "migrate:dry-run": "node scripts/migrate-data-v2.js --dry-run",
    "migrate": "node scripts/migrate-data-v2.js"
  },
  "keywords": [
    "discord",
    "bot",
    "javascript",
    "4sib"
  ],
  "author": "4SIB Team",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.12.2",
    "discord.js": "^14.14.1",
    "dotenv": "^16.3.1",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "nodemonConfig": {
    "ignore": [
      "data/*",
      "data-backups/*",
      "tests/*",
      "node_modules/*"
    ],
    "ext": "js,json",
    "delay": "1000"
  }
}
